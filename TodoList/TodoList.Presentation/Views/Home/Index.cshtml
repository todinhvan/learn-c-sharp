@model IEnumerable<TodoList.Presentation.Models.ItemViewModel>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Todo List</h1>
    <div class="mb-3 text-end">
        <a asp-action="Add" class="btn btn-primary">Add New Item</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="@(item.IsCompleted ? "text-decoration: line-through;" : "")">@item.Title</td>
                    <td>
                        <form asp-action="ToggleComplete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <input type="checkbox" onchange="this.form.submit()" @(item.IsCompleted ? "checked" : "") />
                        </form>
                    </td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detail</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this item?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
